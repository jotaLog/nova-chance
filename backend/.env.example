# SMTP account for sending password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nova Chance <noreply@example.com>"

# Use a URL reachable by the device receiving the email.
# For a physical device, replace localhost with the development machine's LAN address.
PASSWORD_RESET_URL=http://localhost:8082/reset-password
